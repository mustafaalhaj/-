<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>أنا مسلم</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Ana Muslim</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
			<string>fetch</string>
			<string>remote-notification</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>

		<!-- Location Permissions -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>يحتاج تطبيق أنا مسلم إلى تحديد موقعك لحساب مواقيت الصلاة واتجاه القبلة بدقة.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>يحتاج تطبيق أنا مسلم إلى تحديد موقعك لحساب مواقيت الصلاة وتنبيهات الأذان بدقة.</string>
		<key>NSLocationAlwaysUsageDescription</key>
		<string>يحتاج تطبيق أنا مسلم إلى تحديد موقعك لحساب مواقيت الصلاة وتنبيهات الأذان بدقة.</string>

		<!-- Camera & Microphone Permissions -->
		<key>NSCameraUsageDescription</key>
		<string>يحتاج تطبيق أنا مسلم إلى الوصول للكاميرا لاستخدام ميزة الكاميرا التفاعلية في تحديد اتجاه القبلة (AR Qibla).</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>يحتاج تطبيق أنا مسلم إلى استخدام الميكروفون عند تسجيل أو تشغيل الميزات الصوتية.</string>

		<!-- Compass & Motion Sensors Permissions -->
		<key>NSMotionUsageDescription</key>
		<string>يحتاج تطبيق أنا مسلم إلى مستشعرات الحركة والبوصلة لتحديد اتجاه القبلة بدقة متناهية.</string>

		<!-- Photo Library Permissions -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>يحتاج تطبيق أنا مسلم إلى الوصول للمعرض لمشاركتك الصور والبطاقات الإسلامية.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>يحتاج تطبيق أنا مسلم إلى حفظ الصور والبطاقات الإسلامية في المعرض.</string>

		<!-- Background Modes for Background Audio & Notifications -->
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
			<string>remote-notification</string>
			<string>audio</string>
		</array>

		<!-- Notifications Permissions - Required for Prayer Alerts when App is Closed -->
		<key>UIUserNotificationSettings</key>
		<dict>
			<key>UIUserNotificationTypes</key>
			<integer>7</integer>
		</dict>
	</dict>
</plist>
